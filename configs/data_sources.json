{
  "tokenizer_name": "tokenizers/minigpt-bilingual-50304",
  "train_tokenizer_if_missing": true,
  "tokenizer_vocab_size": 50304,
  "tokenizer_max_documents_per_source": 20000,
  "tokenizer_max_chars_per_source": 20000000,
  "tokenizer_max_chars_per_document": 100000,
  "validation_fraction": 0.005,
  "min_chars": 200,
  "max_chars": 5000000,
  "seed": 42,
  "progress_every": 1000,
  "sources": [
    {
      "name": "local_curated_books",
      "path": "~/Downloads/books/**/*.txt",
      "format": "text",
      "strip_gutenberg_boilerplate": true,
      "collapse_repeated_documents": true,
      "record_groups": true,
      "validation_fraction": 0.1,
      "validation_groups": ["The Great Gatsby.txt"],
      "tokenizer_max_chars": 15000000,
      "license": "Mixed/unknown: verify each work before redistribution",
      "provenance": "User-curated local files in ~/Downloads/books",
      "quality_notes": "English and Chinese TXT files; each file is one ordered work and split group"
    },
    {
      "name": "fineweb_edu_english",
      "hf_dataset": "HuggingFaceFW/fineweb-edu",
      "hf_config": "sample-10BT",
      "split": "train",
      "text_field": "text",
      "group_field": "id",
      "shuffle_buffer": 20000,
      "max_tokens": 550000000,
      "license": "ODC-By-1.0 plus CommonCrawl Terms of Use",
      "provenance": "https://huggingface.co/datasets/HuggingFaceFW/fineweb-edu"
    },
    {
      "name": "finemath_4plus",
      "hf_dataset": "HuggingFaceTB/finemath",
      "hf_config": "finemath-4plus",
      "split": "train",
      "text_field": "text",
      "group_field": "url",
      "shuffle_buffer": 10000,
      "max_tokens": 200000000,
      "license": "ODC-By-1.0 plus CommonCrawl Terms of Use",
      "provenance": "https://huggingface.co/datasets/HuggingFaceTB/finemath"
    },
    {
      "name": "pg19_english_literature",
      "hf_dataset": "emozilla/pg19",
      "split": "train",
      "text_field": "text",
      "group_field": "url",
      "shuffle_buffer": 256,
      "max_tokens": 600000000,
      "license": "Apache-2.0 compilation; underlying pre-1919 Gutenberg works",
      "provenance": "https://huggingface.co/datasets/emozilla/pg19"
    },
    {
      "name": "openstax_textbook_synthesis",
      "hf_dataset": "HuggingFaceTB/cosmopedia",
      "hf_config": "openstax",
      "split": "train",
      "text_field": "text",
      "group_field": "prompt",
      "shuffle_buffer": 10000,
      "max_tokens": 150000000,
      "license": "Apache-2.0 dataset; synthetic textbook-style text",
      "provenance": "https://huggingface.co/datasets/HuggingFaceTB/cosmopedia"
    },
    {
      "name": "pes2o_open_science",
      "hf_dataset": "allenai/dolmino-mix-1124",
      "hf_config": "pes2o",
      "split": "train",
      "text_field": "text",
      "group_field": "id",
      "shuffle_buffer": 10000,
      "max_tokens": 150000000,
      "license": "ODC-By-1.0",
      "provenance": "https://huggingface.co/datasets/allenai/dolmino-mix-1124"
    },
    {
      "name": "chinese_fineweb_edu_high_score",
      "hf_dataset": "opencsg/Fineweb-Edu-Chinese-V2.1",
      "split": "train",
      "text_field": "text",
      "shuffle_buffer": 20000,
      "filters": [
        {"field": "score", "op": "gte", "value": 0.8}
      ],
      "max_tokens": 650000000,
      "license": "OpenCSG Community License; verify intended use and redistribution terms",
      "provenance": "https://huggingface.co/datasets/opencsg/Fineweb-Edu-Chinese-V2.1",
      "quality_notes": "Only score >= 0.8 is accepted; exact duplicate removal runs globally"
    },
    {
      "name": "modern_simplified_chinese_longform",
      "enabled": false,
      "hf_dataset": "Geralt-Targaryen/Literature-zh",
      "split": "train",
      "text_field": "text",
      "shuffle_buffer": 256,
      "max_tokens": 150000000,
      "license": "Apache-2.0 dataset compilation; underlying Common Crawl documents retain their original rights and terms",
      "provenance": "https://huggingface.co/datasets/Geralt-Targaryen/Literature-zh",
      "quality_notes": "Modern long-form mixture of books, papers, legal documents, and patents; upstream converts Traditional Chinese to Simplified Chinese and removes model-rated quality levels 1-2. This is not a pure fiction corpus."
    },
    {
      "name": "chinese_classical_literature",
      "hf_dataset": "gujilab/chinese-classical-corpus",
      "hf_config": "corpus",
      "split": "train",
      "text_field": "content",
      "group_field": "source",
      "shuffle_buffer": 256,
      "max_tokens": 50000000,
      "license": "CC0-1.0",
      "provenance": "https://huggingface.co/datasets/gujilab/chinese-classical-corpus"
    }
  ]
}
